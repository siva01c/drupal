<?php

/**
 * @file
 * Startup Factory theme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_HOOK().
 */
function startupfactory_theme_preprocess_page(&$variables) {
  // Add a body class based on the current route.
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name) {
    $variables['attributes']['class'][] = 'route--' . str_replace('.', '-', $route_name);
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function startupfactory_theme_preprocess_node(&$variables) {
  $node = $variables['node'];
  $variables['attributes']['class'][] = 'node--type-' . $node->bundle();
}

/**
 * Implements hook_preprocess_HOOK().
 */
function startupfactory_theme_preprocesscommerce_product(&$variables) {
  $variables['attributes']['class'][] = 'commerce-product';
}
