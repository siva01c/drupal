  return $schema;
}

/**
 * Add ragchat_shop_id column to the project table.
 */
function startupfactory_project_update_8001(&$sandbox) {
  $database = \Drupal::database();
  if (!$database->schema()->fieldExists('project', 'ragchat_shop_id')) {
    $database->schema()->addField('project', 'ragchat_shop_id', [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'RagChat shop node ID for this project.',
    ]);
  }

  // Register the field storage definition so the entity layer knows about it.
  $etm = \Drupal::entityTypeManager();
  $definition = $etm->getDefinition('project');
  $entity_class = $definition->getClass();
  $all_fields = $entity_class::baseFieldDefinitions($definition);
  $field = $all_fields['ragchat_shop_id'];
  $manager = \Drupal::entityDefinitionUpdateManager();
  $manager->installFieldStorageDefinition('ragchat_shop_id', 'project', 'startupfactory_project', $field);

  \Drupal::entityTypeManager()->clearCachedDefinitions();
}
