{
    "name": "startupfactory/drupal",
    "description": "Startup Factory — open-source MVP builder (Drupal 11 + Commerce + AI)",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/siva01c/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.7",
        "drupal/core-composer-scaffold": "^11.0",
        "drupal/core-project-message": "^11.0",
        "drupal/core-recommended": "^11.0",
        "drush/drush": "^13.7",

        "drupal/admin_toolbar": "^3.6",

        "drupal/commerce": "^3.2",
        "drupal/commerce_stripe": "^2.0",
        "drupal/commerce_paypal": "^2.0",

        "drupal/paragraphs": "^1.20",
        "drupal/ui_patterns": "^2.0",

        "drupal/simple_oauth": "^6.0",

        "drupal/votingapi": "^3.0",

        "drupal/eca": "^2.0",

        "drupal/redis": "^1.8",
        "drupal/search_api": "^1.40",
        "drupal/search_api_db": "^1.40",

        "drupal/domain": "^2.0",

        "drupal/pathauto": "^1.14",
        "drupal/metatag": "^2.1",
        "drupal/simple_sitemap": "^4.2",
        "drupal/redirect": "^1.10",

        "drupal/token": "^1.15",
        "drupal/inline_entity_form": "^3.0",
        "drupal/field_group": "^3.6",
        "drupal/webform": "^6.2",

        "drupal/gin": "^4.0",
        "drupal/gin_toolbar": "^2.0",

        "drupal/key": "^1.19",
        "drupal/encrypt": "^3.1",

        "drupal/classy": "^2.0",
        "drupal/block_visibility_groups": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "bin-dir": "bin/",
        "optimize-autoloader": true,
        "process-timeout": 0,
        "preferred-install": {
            "*": "dist"
        }
    },
    "extra": {
        "bin-dir": "bin/",
        "config-dir": "config/",
        "src-dir": "src/",
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "recipes/{$name}": ["type:drupal-recipe"],
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "drupal-core-project-message": {
            "include-keys": ["homepage", "support"]
        }
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "squizlabs/php_codesniffer": "^3.0"
    }
}
